{
  "hosting": {
	  "site": "metras",
    "public": "Frontend",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/pages/login.html",
        "type": 302
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}