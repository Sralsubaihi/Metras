// firestore.chatbot.rules - Reference Firestore security rules for METRAS.
// Merge these conditions into the deployed firestore.rules; do not replace the
// existing create/update rules for projects and tasks without reviewing them.
// Access model: a project's leader (leaderEmail) and members (memberEmails) can
// read it; chatbot conversations are private to the user who created them.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed in with an email address.
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    // Signed-in user's email in lowercase (emails are stored lowercase).
    function email() {
      return request.auth.token.email.lower();
    }

    // Project document by id.
    function project(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    // The user leads / belongs to / has any access to the project.
    function isProjectLeader(projectId) {
      return signedIn() && project(projectId).leaderEmail == email();
    }

    function isProjectMember(projectId) {
      return signedIn()
        && 'memberEmails' in project(projectId)
        && email() in project(projectId).memberEmails;
    }

    function hasProjectAccess(projectId) {
      return isProjectLeader(projectId) || isProjectMember(projectId);
    }

    // Chatbot conversations: only the owner, and only for projects they can access.
    match /chatbotSessions/{sessionId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && hasProjectAccess(request.resource.data.projectId);
      allow read, update, delete: if signedIn()
        && resource.data.userId == request.auth.uid
        && hasProjectAccess(resource.data.projectId);

      // Messages: the owner can read and add them; messages are never edited or deleted.
      match /messages/{messageId} {
        function ownsSession() {
          return signedIn()
            && get(/databases/$(database)/documents/chatbotSessions/$(sessionId)).data.userId == request.auth.uid;
        }
        allow read, create: if ownsSession();
        allow update, delete: if false;
      }
    }

    // Read access for the main collections (merge with the existing rules).
    match /projects/{projectId} {
      allow read: if hasProjectAccess(projectId);
    }

    match /project_results/{resultId} {
      allow read: if hasProjectAccess(resource.data.projectId);
    }

    // Tasks: the leader reads all project tasks; a member reads only tasks assigned to them
    // (current assignedEmails array or legacy assignedTo.email).
    match /tasks/{taskId} {
      allow read: if isProjectLeader(resource.data.projectId)
        || (isProjectMember(resource.data.projectId)
          && (('assignedEmails' in resource.data && email() in resource.data.assignedEmails)
            || ('assignedTo' in resource.data
              && 'email' in resource.data.assignedTo
              && resource.data.assignedTo.email == email())));
    }
  }
}
